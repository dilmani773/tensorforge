# Copy to .env (never commit .env).
API_KEY=put-your-key-here
# Public hostname that points at this server, e.g. tensorforge-paradox.southeastasia.cloudapp.azure.com
DOMAIN=your-hostname.example.com
# Browser origins allowed to call the API (the hosted frontend), comma separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional
ORT_THREADS=0
JOB_RETENTION_HOURS=24
